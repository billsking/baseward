# Database gateway runtime configuration (copy to .env and fill in; never commit to the repo)

# Required: base64-encoded 32-byte master key, generate with python scripts/gen_master_key.py.
# If lost, stored datasource passwords can no longer be decrypted — keep an offline backup.
GATEWAY_MASTER_KEY=

# Admin account created on first start; ignored once an admin already exists.
GATEWAY_ADMIN_USER=admin
GATEWAY_ADMIN_PASSWORD=change-this-password

# ---- Management database ----
# Quick start needs no external database: with everything below unset, the gateway stores its
# management data in a local SQLite file (GATEWAY_DB_PATH; /data/gateway.db in the container).
# SQLite is single-instance only — a production or multi-replica deployment should use
# GATEWAY_DB_URL or the MySQL settings instead.
# GATEWAY_DB_PATH=./data/gateway.db

# Full SQLAlchemy async URL, e.g.:
#   mysql+aiomysql://dbgw:password@127.0.0.1:3306/db_gateway?charset=utf8mb4
#   postgresql+asyncpg://dbgw:password@127.0.0.1:5432/db_gateway  (requires the asyncpg package)
# An explicit URL wins over the GATEWAY_DB_* settings below.
GATEWAY_DB_URL=

# Server-side MySQL management database (used when GATEWAY_DB_URL is empty and GATEWAY_DB_HOST
# is set). Create the database and account beforehand and grant table-creation privileges.
# For MySQL running on the deployment host use host.docker.internal; inside the container
# 127.0.0.1 points at the container itself.
GATEWAY_DB_HOST=
GATEWAY_DB_PORT=3306
GATEWAY_DB_USER=
GATEWAY_DB_PASSWORD=
GATEWAY_DB_NAME=db_gateway

# Public port of the gateway.
GATEWAY_PORT=8080

# Set to true when served behind an HTTPS reverse proxy.
GATEWAY_COOKIE_SECURE=false

GATEWAY_LOG_LEVEL=INFO
# Audit retention in days, written on database creation (change it in the admin UI afterwards).
GATEWAY_AUDIT_RETENTION_DAYS=180

# ---- MySQL protocol temporary export channel (v1.4, disabled by default) ----
# When enabled the gateway listens on an extra MySQL protocol port; scripts and programs
# connect directly with temporary credentials issued in the admin UI.
# v1 has no TLS, so the source IP allowlist is the only network-layer control.
GATEWAY_MYSQL_EXPORT_ENABLED=false
GATEWAY_MYSQL_EXPORT_HOST=0.0.0.0
GATEWAY_MYSQL_EXPORT_PORT=3307
# docker compose only: host NIC IP the export port is bound to.
# Must be an intranet NIC IP (e.g. 192.0.2.10); the default 127.0.0.1 allows local access only.
# Never leave it empty or set it to 0.0.0.0.
GATEWAY_EXPORT_BIND=127.0.0.1
# Comma-separated IPs or CIDRs, e.g. 192.0.2.0/24,192.168.1.20
# Bootstrap only: once the allowlist is saved on the admin settings page, the DB value wins
# and this variable is ignored.
# Empty here and never saved in the UI = all export connections are rejected (the process
# still starts normally and the admin UI is unaffected).
GATEWAY_MYSQL_EXPORT_ALLOW_CIDRS=
GATEWAY_MYSQL_EXPORT_MAX_CONCURRENT=2
GATEWAY_MYSQL_EXPORT_MAX_ROWS=1000000
GATEWAY_MYSQL_EXPORT_MAX_SECONDS=600
GATEWAY_MYSQL_EXPORT_MAX_TTL_HOURS=72
GATEWAY_MYSQL_EXPORT_FETCH_BATCH=10000
# Export address reachable by clients. When the listen address is the 0.0.0.0 wildcard you
# must put a concrete IP here, otherwise MCP large-result handoff only truncates and hints
# instead of issuing credentials. Port 0 means reuse EXPORT_PORT.
GATEWAY_MYSQL_EXPORT_ADVERTISE_HOST=
GATEWAY_MYSQL_EXPORT_ADVERTISE_PORT=0

# ---- MCP language ----
# Language of MCP instructions and tool descriptions: zh or en. Admin pages follow the
# browser/cookie instead; this setting only affects MCP clients.
GATEWAY_MCP_LANGUAGE=zh

# ---- MCP large-result automatic handoff (v1.5) ----
# MCP query results exceeding either limit are truncated to a preview, and a short-lived
# export credential is issued automatically when needed.
# Both set to 0 = no limit (restores v1.4 behaviour).
GATEWAY_MCP_RESULT_MAX_ROWS=2000
GATEWAY_MCP_RESULT_MAX_BYTES=2000000
# When disabled, results are only truncated with a hint and nothing is issued automatically
# (administrators can still issue credentials manually in the web UI).
GATEWAY_MCP_EXPORT_AUTO_ISSUE=true
# TTL of automatic credentials in seconds; must not exceed MYSQL_EXPORT_MAX_TTL_HOURS*3600.
GATEWAY_MCP_EXPORT_TTL_SECONDS=1800
# Max simultaneously active automatic credentials per token + datasource; the oldest one is
# revoked when the limit is exceeded.
GATEWAY_MCP_EXPORT_MAX_ACTIVE=3

# ---- Trusted reverse proxies ----
# X-Forwarded-For is honoured only when the TCP peer falls inside these networks
# (the first non-trusted hop is taken, walking right to left).
# Empty = always use the TCP peer address; leave empty when exposed directly, otherwise the
# header can be spoofed.
GATEWAY_TRUSTED_PROXIES=

# ---- MCP entry source IP allowlist ----
# Comma- or newline-separated IPs / CIDRs; can also be saved on the admin settings page
# (the DB value wins).
# Unlike the export channel, an unconfigured allowlist here (and in the UI) does not restrict
# the source, so upgrading does not lock out existing callers.
# Once saved, requests outside the allowlist get 403 (checked before the token).
# The source IP is taken from X-Forwarded-For only when the request comes from
# GATEWAY_TRUSTED_PROXIES; otherwise the TCP peer address is used.
GATEWAY_MCP_ALLOW_CIDRS=
