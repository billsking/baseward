# Integration test connection settings (copy to .env.test; never commit it to the repo)
# The test account needs CREATE DATABASE / DROP DATABASE privileges; tests only create and drop
# temporary databases prefixed with dbgw_test_* and never touch other databases.

TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=dbgw_test
TEST_DB_PASSWORD=
TEST_DB_PREFIX=dbgw_test

# Test admin account (created when a temporary database is initialised).
TEST_ADMIN_USER=admin
TEST_ADMIN_PASSWORD=admin-test-123
